# ---- Servidor ----
PORT=3000
NODE_ENV=development
ADMIN_TOKEN=pon_aqui_un_token_largo_y_aleatorio

# ---- MySQL (8.0.16+) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=levelup_pc
DB_USER_HOST=localhost
# Usuario que usa la APP (permisos mínimos: SELECT, INSERT, UPDATE)
DB_USER=app_cliente
DB_PASSWORD=cambia_esta_clave_app
# Solo para npm run db:seed (administración)
DB_ADMIN_USER=admin_levelup
DB_ADMIN_PASSWORD=cambia_esta_clave_admin
# Solo para npm run db:setup (puedes borrarlas después)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# ---- OpenAI (opcional) ----
OPENAI_API_KEY=
CHATBOT_MODEL=gpt-4o-mini
CHATBOT_MAX_TOKENS=300
CHATBOT_TEMPERATURE=0.7
